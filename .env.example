# Copy to .env and edit. NEVER commit .env — it holds secrets.
APP_ENV=local

# Local default is SQLite so you can start without Docker.
# Under docker compose this is overridden to point at Postgres.
DATABASE_URL=sqlite:///./adlens.db

# Leave empty to use an in-process cache. Example: redis://localhost:6379/0
REDIS_URL=

# fake = offline rule-based stub (no API key, deterministic, used in tests/CI)
# openai_compat = any OpenAI-compatible endpoint: Ollama, vLLM, LiteLLM proxy, OpenAI, Azure via gateway
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-ollama
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Default comes from app/config.py. Override per environment for A/B tests or an
# instant rollback (flip the env var, no code change):
# PROMPT_VERSION=v1
CACHE_TTL_S=86400
LOG_LEVEL=INFO
